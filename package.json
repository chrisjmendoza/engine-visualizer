{
  "name": "engine-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive slider-crank engine kinematics visualizer built with React, TypeScript, and Three.js",
  "author": "Chris Mendoza",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.182.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
